<h1>All Products</h1>

<ul>
  <% @products.each do |product| %>
    <li>
      <strong><%= link_to product.title, product_path(product) %></strong> - 
      <%= number_to_currency(product.price) %> 
      (Stock: <%= product.stock_quantity %>)
      <p><%= product.description %></p>
    </li>
  <% end %>
</ul>